# Waybar file configuration
# location : ~/.config/waybar/config

{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 4,
    "modules-left": ["wlr/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "tray"],
    
    "clock": {
        "format": "{:%H:%M  %d/%m/%Y}",
        "tooltip": false
    },
    
    "pulseaudio": {
        "format": "Vol: {volume}%",
        "format-muted": "Muted"
    },
    
    "network": {
        "format-wifi": "WiFi: {essid}",
        "format-disconnected": "Offline",
        "tooltip": false
    },
    
    "tray": {
        "spacing": 8
    }
}
