<! # Labwc Keybinding -->
<! # location : ~/.config/labwc/rc.xml -->

<?xml version="1.0"?>
<labwc_config>
  <keyboard>
    <!-- Buka Terminal (Super + Return) -->
    <key bind="W-Return">
      <action name="Execute" command="kitty" />
    </key>
    <!-- Buka Fuzzel Launcher (Super + Space) -->
    <key bind="W-space">
      <action name="Execute" command="fuzzel" />
    </key>
    <!-- Keluar / Close Jendela Aktif (Alt + F4) -->
    <key bind="A-F4">
      <action name="Close" />
    </key>
  </keyboard>
</labwc_config>
