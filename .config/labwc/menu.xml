<?xml version="1.0" encoding="UTF-8"?>
<!--
  Menu klik kanan labwc (klik kanan di desktop kosong)
  Lokasi : ~/.config/labwc/menu.xml
  Terapkan perubahan: Super+Alt+R atau pilih Reconfigure di menu ini.
  Menu klik kanan di bingkai jendela tidak diubah, tetap memakai bawaan labwc.
-->
<openbox_menu>

  <menu id="root-menu">

    <!-- Ganti firefox dengan browser pilihan Anda, mis. chromium atau brave -->
    <item label="Web Browser">
      <action name="Execute" command="firefox" />
    </item>

    <item label="Terminal">
      <action name="Execute" command="kitty" />
    </item>

    <item label="File Manager">
      <action name="Execute" command="thunar" />
    </item>

    <!-- Membuka fuzzel, yang menampilkan semua aplikasi terpasang -->
    <item label="All Applications">
      <action name="Execute" command="fuzzel" />
    </item>

    <separator />

    <item label="Reconfigure">
      <action name="Reconfigure" />
    </item>

    <menu id="power-menu" label="Power">
      <item label="Lock">
        <action name="Execute" command="swaylock -f" />
      </item>
      <item label="Suspend">
        <action name="Execute" command="systemctl suspend" />
      </item>
      <item label="Reboot">
        <action name="Execute" command="systemctl reboot" />
      </item>
      <item label="Shutdown">
        <action name="Execute" command="systemctl poweroff" />
      </item>
    </menu>

    <!-- Di bawah uwsm, keluar sesi harus lewat uwsm stop, bukan Exit bawaan labwc -->
    <item label="Exit">
      <action name="Execute">
        <command>sh -c "uwsm stop 2>/dev/null || labwc --exit"</command>
      </action>
    </item>

  </menu>

</openbox_menu>
